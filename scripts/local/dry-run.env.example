# Configuration for scripts/local/run_disconnected_dry_run.sh
#
# Copy to scripts/local/dry-run.env and fill in the values, then run:
#   ./scripts/local/run_disconnected_dry_run.sh
#
# These mirror the GitHub Actions secrets/variables the Disconnected Dry-Run
# workflow consumes. Anything already exported in your shell takes precedence.

# --- Required ---

# Base directory under which per-cluster working dirs are created
# (workflow: vars.BASE_WORKING_DIR). Must be writable and on a disk with room.
BASE_WORKING_DIR=/opt/clusters

# OpenShift pull secret (workflow: secrets.PULL_SECRET).
# Recommended: a path to your pull secret JSON file. This avoids the shell
# stripping the quotes out of the JSON when this env file is sourced.
PULL_SECRET=/path/to/pull-secret.json
#
# Alternatively, inline the JSON — but then it MUST be single-quoted, otherwise
# sourcing this file removes the double quotes and corrupts the secret:
# PULL_SECRET='{"auths":{...}}'

# --- Optional: Landing Zone RHSM registration (recommended for disconnected) ---
# Without these the LZ VM is not subscription-registered.
LZ_RHSM_ORG=
LZ_RHSM_ACTIVATION_KEY=

# --- Optional: Landing Zone cloud image (defaults to CentOS Stream 10) ---
# LZ_CLOUD_IMAGE_URL=https://cloud.centos.org/centos/10-stream/x86_64/images/CentOS-Stream-GenericCloud-10-latest.x86_64.qcow2
# LZ_CLOUD_IMAGE_NAME=centos-stream-10-cloud.qcow2

# --- Optional: cluster name (auto-generated as eci-<hash> when unset) ---
# ENCLAVE_CLUSTER_NAME=eci-local01

# --- Optional: cross-run VM reaping before the run (matches CI self-heal) ---
# ENABLE_PREJOB_REAP=true
# REAP_AGE_HOURS=12

# --- Optional: keep the environment after the run for inspection ---
# Set to true to skip artifact collection + teardown at the end.
# SKIP_CLEANUP=false
