<domain type='kvm'>
  <name>{{ name }}</name>
  <uuid>{{ uuid }}</uuid>
  <memory unit='KiB'>{{ memory_kb }}</memory>
  <vcpu placement='static'>{{ vcpu }}</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
{% for dev in boot_order | default(['cdrom', 'hd']) %}
    <boot dev='{{ dev }}'/>
{% endfor %}
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='on'/>
  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>
    <controller type='sata' index='0'/>
    <disk type='file' device='disk'>
      <!-- writeback: use host page cache; honors guest flushes but unflushed data is lost on host crash - fine for these ephemeral, non-migrated VMs -->
      <driver name='qemu' type='qcow2' cache='writeback'/>
      <source file='{{ pool_path }}/{{ vol_name }}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
{% if cdrom_path | default('') %}
      <source file='{{ cdrom_path }}'/>
{% endif %}
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
{% if extra_disk_path %}
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw' cache='writeback'/>
      <source file='{{ extra_disk_path }}'/>
      <target dev='vdb' bus='virtio'/>
    </disk>
{% endif %}
{% for nic in nics %}
    <interface type='network'>
      <mac address='{{ nic.mac }}'/>
      <source network='{{ nic.network }}'/>
      <model type='virtio'/>
    </interface>
{% endfor %}
    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <video>
      <model type='vga'/>
    </video>
    <graphics type='vnc' port='-1' autoport='yes'/>
  </devices>
</domain>
