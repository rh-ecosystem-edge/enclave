[Unit]
Description=PostgreSQL Podman Container for Quay
Wants=network.target
After=network-online.target quay-pod.service
Requires=quay-pod.service

[Service]
Type=simple
TimeoutStartSec=5m
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecStartPre=-/bin/rm -f %t/%n-pid %t/%n-cid
ExecStart=/usr/bin/podman run \
    --name quay-postgres \
    --pod=quay-pod \
    -v {{ quayPgVolume }}:/var/lib/pgsql/data:Z,U \
    --image-volume=ignore \
    -e POSTGRESQL_USER={{ quayPgUser }} \
    -e POSTGRESQL_DATABASE={{ quayPgDatabase }} \
    -e POSTGRESQL_PASSWORD={{ quayPgPassword }} \
    -e POSTGRESQL_MAX_CONNECTIONS={{ quayPgMaxConnections }} \
    --conmon-pidfile %t/%n-pid \
    --cidfile %t/%n-cid \
    --cgroups=no-conmon \
    --log-driver=journald \
    --replace \
    {{ quayPgImage }}
ExecStop=-/usr/bin/podman stop --ignore --cidfile %t/%n-cid -t 10
ExecStopPost=-/usr/bin/podman rm --ignore -f --cidfile %t/%n-cid
PIDFile=%t/%n-pid
KillMode=none
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target default.target
