FROM registry.access.redhat.com/ubi10/ubi@sha256:6e3f045f5380e8d8dffaea7e01bf926d2db44aff751048697e780d1253687843

# Configure DNS
RUN echo "nameserver 8.8.8.8" > /etc/resolv.conf && \
    echo "nameserver 8.8.4.4" >> /etc/resolv.conf

# Install EPEL for additional packages like shellcheck
RUN dnf install -y \
    https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm && \
    dnf clean all

# Install system dependencies
RUN dnf install -y --allowerasing \
    ca-certificates \
    curl \
    make \
    openssl \
    shellcheck \
    python3 \
    python3-pip \
    tar \
    gzip \
    git \
    && dnf clean all

# Install Docker CLI
RUN dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo && \
    dnf install -y docker-ce-cli && \
    dnf clean all

# Install GitHub CLI (gh)
RUN dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo && \
    dnf install -y gh && \
    dnf clean all

# Install uv (pinned version)
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /usr/local/bin/uv

# Set working directory
WORKDIR /workspace

# Copy project metadata and source for dependency installation
COPY pyproject.toml uv.lock .python-version README.md /workspace/

# Install ONLY dependencies, skip the project itself. We don't install
# the project in the first uv sync so that we can can leverage the cache
# of the deps resolution layer leading to faster builds.
RUN uv sync --all-groups --no-install-project
COPY src/ /workspace/src/
RUN uv sync --all-groups --no-editable

# Put venv on PATH so all commands are available
ENV PATH="/workspace/.venv/bin:$PATH"

# Install Helm — used by validate-osac-values to render + schema-check the OSAC
# values overlay via `helm template`. Source the version and checksum from
# defaults/control_binaries.yaml (parsed with the venv's PyYAML) so CI uses the
# exact helm the deploy installs (playbooks/tasks/download_control_binaries.yaml),
# keeping the version in one place for renovate. That entry is a raw amd64 binary
# from the OpenShift mirror; the CI image is built amd64-only, so no per-arch
# handling is needed. NOTE: defaults/control_binaries.yaml is in the CI-image
# rebuild path-filter (resolve-ci-image.yml) so a helm bump rebuilds this image.
COPY defaults/control_binaries.yaml /tmp/control_binaries.yaml
RUN set -eux; \
    arch="$(uname -m)"; \
    [ "${arch}" = "x86_64" ] || { echo "control_binaries helm is amd64-only; unsupported build arch: ${arch}" >&2; exit 1; }; \
    helm_url="$(python -c "import yaml; print(yaml.safe_load(open('/tmp/control_binaries.yaml'))['control_binaries']['helm']['url'])")"; \
    helm_checksum="$(python -c "import yaml; print(yaml.safe_load(open('/tmp/control_binaries.yaml'))['control_binaries']['helm']['checksum'])")"; \
    curl -fsSL "${helm_url}" -o /usr/local/bin/helm; \
    echo "${helm_checksum#sha256:}  /usr/local/bin/helm" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/helm; \
    rm -f /tmp/control_binaries.yaml; \
    helm version

# Pre-install Ansible Galaxy collections
COPY ansible_collections.txt /tmp/ansible_collections.txt
RUN ansible-galaxy collection install -r /tmp/ansible_collections.txt && \
    rm /tmp/ansible_collections.txt

# Symlink collections to /usr/local for system-wide access
RUN mkdir -p /usr/local/share/ansible/collections && \
    ln -s /root/.ansible/collections/ansible_collections /usr/local/share/ansible/collections/ansible_collections

# Set environment variable for Ansible to find collections
ENV ANSIBLE_COLLECTIONS_PATH=/usr/local/share/ansible/collections:/root/.ansible/collections

CMD ["/bin/bash"]
