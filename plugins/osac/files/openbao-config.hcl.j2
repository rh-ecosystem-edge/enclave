ui = false
disable_mlock = true
api_addr = "https://openbao.{{ osac_vault_ns }}.svc.cluster.local:8200"
cluster_addr = "https://127.0.0.1:8201"

storage "raft" {
  path = "/vault/data"
  node_id = "openbao"
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "/vault/tls/tls.crt"
  tls_key_file  = "/vault/tls/tls.key"
}
